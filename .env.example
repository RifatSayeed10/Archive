# ==============================================================================
# Research Archive - Environment Configuration Template
# Copy this file to .env before starting the Docker Compose stack or local server.
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3000
APP_PORT=3000

# Security - JWT Token Signing Key (REQUIRED in Production)
# Generate a strong, random 64-character secret (e.g., using `openssl rand -hex 32`)
JWT_SECRET=CHANGE_ME_REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Database Storage & Authentication Mode
# In production on QNAP NAS, set REQUIRE_MONGODB to true
REQUIRE_MONGODB=true

# MongoDB Credentials (Used by both the app and mongo containers)
MONGO_INITDB_ROOT_USERNAME=archive_admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD_HERE

# Full MongoDB connection URI (Constructed automatically in docker-compose.yml)
MONGODB_URI=mongodb://archive_admin:CHANGE_ME_STRONG_DATABASE_PASSWORD_HERE@mongo:27017/research_archive?authSource=admin

# MongoDB Container Image Version (e.g. mongo:7.0 or mongo:8.0)
MONGO_IMAGE=mongo:7.0

# QNAP NAS Persistent Host Mount Paths
# Replace with absolute shared folder paths on your QNAP volume (e.g. /share/CACHEDEV1_DATA/Container/research-archive/...)
NAS_APP_DATA_PATH=/share/Container/research-archive/app-data
NAS_MONGO_DATA_PATH=/share/Container/research-archive/mongo-data

# Internal App Directory Configuration (Defaults inside container)
DATA_DIR=/app-data
UPLOAD_DIR=/app-data/uploads
DB_BACKUP_FILE=/app-data/archive-database.json

# Initial Admin Account Password (Optional - if left unset, a random password is generated and logged)
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_OR_LEAVE_EMPTY
